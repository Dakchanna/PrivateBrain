# ============================================================
# PRIVATEBRAIN ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ============================================================
# DATABASE (Supabase PostgreSQL)
# ============================================================
# Get this from: Supabase Dashboard → Project → Settings → Database → Connection String (URI mode)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ============================================================
# REDIS (for priority queue and pub/sub)
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# AI AGENT / REASONING MODEL (Ollama)
# ============================================================
# Model name as available in your Ollama installation
AGENT_MODEL=qwen2.5:3b
# Ollama server base URL
MODEL_BASE_URL=http://localhost:11434

# ============================================================
# TASK-SPECIFIC AI MODELS
# ============================================================
# Object detection model (ultralytics YOLOv8)
OBJECT_DETECTION_MODEL=yolov8n.pt
# Image classification model (torchvision)
IMAGE_CLASSIFICATION_MODEL=mobilenet_v2
# Speech processing model (openai-whisper)
SPEECH_MODEL=tiny

# ============================================================
# SECURITY
# ============================================================
# Strong random secret for API key signing (generate with: openssl rand -hex 32)
API_SECRET=change_me_to_a_strong_random_secret_at_least_32_chars
# JWT secret for dashboard authentication (if applicable)
JWT_SECRET=change_me_to_another_strong_random_secret

# ============================================================
# API / CORS
# ============================================================
# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Environment mode: development | production
ENVIRONMENT=development

# ============================================================
# SCHEDULER
# ============================================================
# Maximum concurrent workers processing AI requests
MAX_WORKERS=4
# Request timeout in seconds
REQUEST_TIMEOUT=60
# Maximum retries before fallback/failure
MAX_RETRIES=2

# ============================================================
# FRONTEND (Vite)
# ============================================================
# Set in frontend/.env or frontend/.env.local
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
